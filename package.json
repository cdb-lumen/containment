{
  "name": "alien-shooter-containment",
  "version": "0.1.0",
  "description": "An original browser survival shooter built with Phaser, TypeScript, and procedural audiovisuals.",
  "private": true,
  "license": "MIT",
  "homepage": "https://cdb-lumen.github.io/alien-shooter-containment/",
  "repository": {
    "type": "git",
    "url": "https://github.com/cdb-lumen/alien-shooter-containment.git"
  },
  "keywords": [
    "phaser",
    "typescript",
    "browser-game",
    "survival-shooter"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "verify": "npm run lint && npm run test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "eslint": "10.6.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
